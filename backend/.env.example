# PostgreSQL Database Connection URL (Pooled endpoint for Neon/Vercel serverless runtime)
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/delivery_tracker?sslmode=require"

# Direct Database Connection URL (Unpooled endpoint for Prisma migrations)
DIRECT_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/delivery_tracker?sslmode=require"


# Express API Port
PORT=4000

# Environment Mode
NODE_ENV=development

# Secret key used for signing JWT auth tokens
JWT_SECRET="your-jwt-secret-key"

# Allowed origin for CORS headers
CORS_ORIGIN="http://localhost:5173"

# Google Maps API Key for Distance Matrix Calculation (optional, defaults to mock fallback)
GOOGLE_MAPS_API_KEY=""

# Resend API Key for Email Notifications (optional)
RESEND_API_KEY=""

# SMTP Credentials for Nodemailer (fallback optional)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="notifications@deliverytracker.com"
