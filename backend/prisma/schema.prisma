generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  AGENT
  ADMIN
}

enum OrderType {
  B2B
  B2C
}

enum RateType {
  INTRA_ZONE
  INTER_ZONE
}

enum PaymentType {
  PREPAID
  COD
}

enum OrderStatus {
  CREATED
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RESCHEDULED
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationStatus {
  SENT
  FAILED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  phone        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agentProfile       AgentProfile?
  customerOrders     Order[]             @relation("CustomerOrders")
  createdOrders      Order[]             @relation("AdminCreatedOrders")
  statusHistories    OrderStatusHistory[]
  rescheduleRequests RescheduleRequest[]

  @@map("users")
}

model AgentProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  zoneId       String
  zone         Zone     @relation(fields: [zoneId], references: [id])
  currentLat   Float?
  currentLng   Float?
  isAvailable  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedOrders       Order[]
  reassignedReschedules RescheduleRequest[]

  @@map("agent_profiles")
}

model Zone {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  areas  Area[]
  agents AgentProfile[]

  @@map("zones")
}

model Area {
  id        String   @id @default(uuid())
  name      String   @unique
  zoneId    String
  zone      Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pickupOrders Order[] @relation("PickupAreaOrders")
  dropOrders   Order[] @relation("DropAreaOrders")

  @@map("areas")
}

model RateCard {
  id            String    @id @default(uuid())
  orderType     OrderType
  rateType      RateType
  chargePerKm   Decimal   @default(8.00) @db.Decimal(10, 2)
  ratePerKg     Decimal   @db.Decimal(10, 2)
  baseFee       Decimal   @default(0.00) @db.Decimal(10, 2)
  effectiveFrom DateTime  @default(now())
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders Order[]

  @@map("rate_cards")
}

model CodSurcharge {
  id        String    @id @default(uuid())
  orderType OrderType
  amount    Decimal   @db.Decimal(10, 2)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("cod_surcharges")
}

model Order {
  id                    String      @id @default(uuid())
  orderNumber           String      @unique
  customerId            String
  customer              User        @relation("CustomerOrders", fields: [customerId], references: [id])
  createdByAdminId      String?
  createdByAdmin        User?       @relation("AdminCreatedOrders", fields: [createdByAdminId], references: [id])
  pickupAddress         String
  pickupAreaId          String
  pickupArea            Area        @relation("PickupAreaOrders", fields: [pickupAreaId], references: [id])
  dropAddress           String
  dropAreaId            String
  dropArea              Area        @relation("DropAreaOrders", fields: [dropAreaId], references: [id])
  lengthCm              Float
  breadthCm             Float
  heightCm              Float
  actualWeightKg        Float
  volumetricWeightKg    Float
  chargeableWeightKg    Float
  distanceKm            Float       @default(0.0)
  chargePerKm           Decimal     @default(8.00) @db.Decimal(10, 2)
  orderType             OrderType
  paymentType           PaymentType
  rateCardIdUsed        String
  rateCardUsed          RateCard    @relation(fields: [rateCardIdUsed], references: [id])
  baseFee               Decimal     @db.Decimal(10, 2)
  weightCharge          Decimal     @db.Decimal(10, 2)
  codSurcharge          Decimal     @db.Decimal(10, 2)
  totalCharge           Decimal     @db.Decimal(10, 2)
  currentStatus         OrderStatus @default(CREATED)
  assignedAgentId       String?
  assignedAgent         AgentProfile? @relation(fields: [assignedAgentId], references: [id])
  scheduledDeliveryDate DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  statusHistory      OrderStatusHistory[]
  rescheduleRequests RescheduleRequest[]
  notifications      NotificationLog[]

  @@index([customerId])
  @@index([assignedAgentId])
  @@index([currentStatus])
  @@index([pickupAreaId])
  @@index([dropAreaId])
  @@index([currentStatus, assignedAgentId])
  @@map("orders")
}

model OrderStatusHistory {
  id              String      @id @default(uuid())
  orderId         String
  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status          OrderStatus
  changedByUserId String
  changedByUser   User        @relation(fields: [changedByUserId], references: [id])
  note            String?
  createdAt       DateTime    @default(now())

  @@index([orderId])
  @@map("order_status_histories")
}

model RescheduleRequest {
  id                    String        @id @default(uuid())
  orderId               String
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  previousScheduledDate DateTime?
  newScheduledDate      DateTime
  requestedByUserId     String
  requestedByUser       User          @relation(fields: [requestedByUserId], references: [id])
  reassignedAgentId     String?
  reassignedAgent       AgentProfile? @relation(fields: [reassignedAgentId], references: [id])
  createdAt             DateTime      @default(now())

  @@index([orderId])
  @@map("reschedule_requests")
}

model NotificationLog {
  id           String              @id @default(uuid())
  orderId      String?
  order        Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  channel      NotificationChannel
  recipient    String
  status       NotificationStatus
  errorMessage String?
  createdAt    DateTime            @default(now())

  @@index([orderId])
  @@map("notification_logs")
}
